layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer B0 { vec4 pred[]; };
layout(std430, binding = 1) writeonly buffer B1 { vec2 dens[]; };
layout(std430, binding = 2) readonly buffer B2 { uint starts[]; };
layout(std430, binding = 3) readonly buffer B3 { uint counts[]; };

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uNumParticles) return;

    vec3 p = pred[i].xyz;
    ivec3 c = CellCoord(p);
    float h2 = uH * uH;
    float density = 0.0;
    float nearDensity = 0.0;

    for (int dz = -ZR; dz <= ZR; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++)
    {
        ivec3 cc = c + ivec3(dx, dy, dz);
        if (!CellInGrid(cc)) continue;
        int ci = CellIndex(cc);
        uint s = starts[ci];
        uint e = s + counts[ci];
        for (uint j = s; j < e; j++)
        {
            vec3 o = pred[j].xyz - p;
            float r2 = dot(o, o);
            if (r2 >= h2) continue;
            float r = sqrt(r2);
            density += DensityKernel(r);
            nearDensity += NearDensityKernel(r);
        }
    }
    dens[i] = vec2(density, nearDensity);
}
