// Gravity + mouse interaction, then predicted positions used for the neighbour search.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer B0 { vec4 pos[]; };
layout(std430, binding = 1) buffer B1 { vec4 vel[]; };
layout(std430, binding = 2) writeonly buffer B2 { vec4 pred[]; };

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uNumParticles) return;

    vec3 p = pos[i].xyz;
    vec3 v = vel[i].xyz;
    vec3 gravity = vec3(0.0, -uGravity, 0.0);
    vec3 accel = gravity;

    if (uInteractStrength != 0.0)
    {
        vec3 offset = uInteractPos - p;
        float d2 = dot(offset, offset);
        if (d2 < uInteractRadius * uInteractRadius)
        {
            float d = sqrt(d2);
            float centreT = 1.0 - d / uInteractRadius;
            vec3 dir = d > 1e-5 ? offset / d : vec3(0.0);
            float gravityWeight = 1.0 - centreT * clamp(abs(uInteractStrength) / 10.0, 0.0, 1.0);
            accel = gravity * gravityWeight + dir * centreT * uInteractStrength;
            accel -= v * centreT;   // damp motion inside the brush for a controllable feel
        }
    }

    v += accel * uDt;
#if DIM == 2
    v.z = 0.0;
#endif
    vel[i] = vec4(v, 0.0);
    pred[i] = vec4(p + v * (1.0 / 120.0), 0.0);
}
