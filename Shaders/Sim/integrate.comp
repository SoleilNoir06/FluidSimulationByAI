layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer B0 { vec4 pos[]; };
layout(std430, binding = 1) writeonly buffer B1 { vec4 vel[]; };
layout(std430, binding = 2) readonly buffer B2 { vec4 velNew[]; };

const float MaxSpeed = 60.0;  // safety net against rare blow-ups

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uNumParticles) return;

    vec3 v = velNew[i].xyz;
    if (any(isnan(v))) v = vec3(0.0);
    float sp = length(v);
    if (sp > MaxSpeed) v *= MaxSpeed / sp;

    vec3 p = pos[i].xyz + v * uDt;
    if (any(isnan(p))) p = vec3(0.0);

    vec3 halfSize = 0.5 * uBoundsSize - vec3(1e-3);
    for (int a = 0; a < DIM; a++)
    {
        if (abs(p[a]) > halfSize[a])
        {
            p[a] = halfSize[a] * sign(p[a]);
            v[a] *= -uCollisionDamping;
        }
    }
#if DIM == 2
    p.z = 0.0; v.z = 0.0;
#endif
    pos[i] = vec4(p, 1.0);
    vel[i] = vec4(v, 0.0);
}
