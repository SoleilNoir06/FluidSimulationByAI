// Pressure (+ near pressure) and viscosity, written to a separate velocity buffer
// so that every thread reads a consistent snapshot of its neighbours.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer B0 { vec4 pred[]; };
layout(std430, binding = 1) readonly buffer B1 { vec4 vel[]; };
layout(std430, binding = 2) readonly buffer B2 { vec2 dens[]; };
layout(std430, binding = 3) readonly buffer B3 { uint starts[]; };
layout(std430, binding = 4) readonly buffer B4 { uint counts[]; };
layout(std430, binding = 5) writeonly buffer B5 { vec4 velOut[]; };

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uNumParticles) return;

    vec3 p = pred[i].xyz;
    vec3 vi = vel[i].xyz;
    vec2 di = dens[i];
    float pressure = (di.x - uTargetDensity) * uPressureMult;
    float nearPressure = di.y * uNearPressureMult;

    ivec3 c = CellCoord(p);
    float h2 = uH * uH;
    vec3 force = vec3(0.0);
    vec3 visc = vec3(0.0);

    for (int dz = -ZR; dz <= ZR; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++)
    {
        ivec3 cc = c + ivec3(dx, dy, dz);
        if (!CellInGrid(cc)) continue;
        int ci = CellIndex(cc);
        uint s = starts[ci];
        uint e = s + counts[ci];
        for (uint j = s; j < e; j++)
        {
            if (int(j) == i) continue;
            vec3 o = pred[j].xyz - p;
            float r2 = dot(o, o);
            if (r2 >= h2) continue;
            float r = sqrt(r2);
            // Coincident particles: separate them along a pseudo-random direction.
            vec3 dir = r > 1e-6 ? o / r : normalize(vec3(fract(float(i) * 0.618) - 0.5, 1.0, 0.0));

            vec2 dj = dens[j];
            float pj = (dj.x - uTargetDensity) * uPressureMult;
            float npj = dj.y * uNearPressureMult;
            float sharedP = 0.5 * (pressure + pj);
            float sharedNP = 0.5 * (nearPressure + npj);

            force += dir * DensityDerivative(r) * sharedP / max(dj.x, 1e-5);
            force += dir * NearDensityDerivative(r) * sharedNP / max(dj.y, 1e-5);
            visc += (vel[j].xyz - vi) * ViscosityKernel(r);
        }
    }

    vec3 accel = force / max(di.x, 1e-5);
    vi += accel * uDt + visc * uViscosity * uDt;
#if DIM == 2
    vi.z = 0.0;
#endif
    velOut[i] = vec4(vi, 0.0);
}
