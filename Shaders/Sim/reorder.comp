// Counting sort, step 4: physically reorder particle data so neighbours are contiguous in memory.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer B0 { uint perm[]; };
layout(std430, binding = 1) readonly buffer B1 { vec4 posIn[]; };
layout(std430, binding = 2) readonly buffer B2 { vec4 velIn[]; };
layout(std430, binding = 3) readonly buffer B3 { vec4 predIn[]; };
layout(std430, binding = 4) writeonly buffer B4 { vec4 posOut[]; };
layout(std430, binding = 5) writeonly buffer B5 { vec4 velOut[]; };
layout(std430, binding = 6) writeonly buffer B6 { vec4 predOut[]; };

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uNumParticles) return;
    uint src = perm[i];
    posOut[i] = posIn[src];
    velOut[i] = velIn[src];
    predOut[i] = predIn[src];
}
