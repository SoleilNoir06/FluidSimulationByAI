// Counting sort, step 2c: add block offsets to get global cell start indices.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer B0 { uint starts[]; };
layout(std430, binding = 1) readonly buffer B1 { uint blockSums[]; };

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < uint(uNumCells)) starts[i] += blockSums[i / 1024u];
}
